<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer halo, weakest -->
    <item android:top="-18dp" android:bottom="-18dp"
          android:left="-18dp" android:right="-18dp">
        <shape android:shape="rectangle">
            <solid android:color="#0F8B5CF6"/>
            <corners android:radius="40dp"/>
        </shape>
    </item>
    <!-- Mid halo -->
    <item android:top="-12dp" android:bottom="-12dp"
          android:left="-12dp" android:right="-12dp">
        <shape android:shape="rectangle">
            <solid android:color="#1F8B5CF6"/>
            <corners android:radius="34dp"/>
        </shape>
    </item>
    <!-- Inner halo -->
    <item android:top="-6dp" android:bottom="-6dp"
          android:left="-6dp" android:right="-6dp">
        <shape android:shape="rectangle">
            <solid android:color="#3D8B5CF6"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>

    <!-- Card body: near-black, subtle vertical gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="#141620"
                android:centerColor="#0D0E15"
                android:endColor="#09090D"/>
            <stroke android:width="1dp" android:color="#8B5CF6"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>

    <!-- Top inner shine -->
    <item android:top="2dp" android:left="10dp" android:right="10dp"
          android:bottom="120dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="#1A8B5CF6"
                android:endColor="#008B5CF6"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
