<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Charcoal base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#111318"/>
        </shape>
    </item>

    <!-- Top-left purple atmospheric glow -->
    <item android:gravity="top|start"
          android:top="-160dp" android:left="-160dp"
          android:right="200dp" android:bottom="400dp">
        <shape android:shape="oval">
            <gradient android:type="radial"
                android:gradientRadius="50%p"
                android:startColor="#35A855F7"
                android:centerColor="#15A855F7"
                android:endColor="#00A855F7"/>
        </shape>
    </item>

    <!-- Top-right blue atmospheric glow -->
    <item android:gravity="top|end"
          android:top="-200dp" android:right="-160dp"
          android:left="200dp" android:bottom="400dp">
        <shape android:shape="oval">
            <gradient android:type="radial"
                android:gradientRadius="50%p"
                android:startColor="#2A3B82F6"
                android:centerColor="#103B82F6"
                android:endColor="#003B82F6"/>
        </shape>
    </item>

    <!-- Subtle cyan hint in the lower third -->
    <item android:gravity="bottom"
          android:bottom="40dp" android:left="100dp" android:right="100dp"
          android:top="500dp">
        <shape android:shape="oval">
            <gradient android:type="radial"
                android:gradientRadius="50%p"
                android:startColor="#1806B6D4"
                android:endColor="#0006B6D4"/>
        </shape>
    </item>
</layer-list>
