<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="#2A2A2A"
                android:endColor="#0C0C0C"/>
            <stroke android:width="2dp" android:color="#FF0000"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:top="2dp" android:left="6dp" android:right="6dp" android:bottom="24dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="#44FCFC3D"
                android:endColor="#00FCFC3D"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</layer-list>
