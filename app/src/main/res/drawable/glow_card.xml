<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Soft outer glow -->
    <item android:left="2dp" android:right="2dp" android:top="6dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#50FFFC5C"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>

    <!-- Main card -->
    <item android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#101010"/>
            <stroke
                android:width="2dp"
                android:color="#FFFC5C"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>

</layer-list>
