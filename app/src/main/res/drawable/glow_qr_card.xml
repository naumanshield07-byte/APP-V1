<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- QR card glow -->
    <item android:left="2dp" android:right="2dp" android:top="7dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#55FFFC5C"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>

    <!-- QR card -->
    <item android:bottom="7dp">
        <shape android:shape="rectangle">
            <solid android:color="#0D0D0D"/>
            <stroke
                android:width="2dp"
                android:color="#FFFC5C"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>

</layer-list>
