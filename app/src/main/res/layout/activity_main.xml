<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#080808"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MODE SELECTION -->
    <LinearLayout
        android:id="@+id/modeSelection"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#080808"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/appLogo"
            android:src="@drawable/qr_generator_logo"
            android:contentDescription="QR Generator logo"
            android:scaleType="fitCenter"
            android:layout_width="180dp"
            android:layout_height="180dp"/>

        <TextView
            android:text="QR GENERATOR"
            android:textColor="#FCFC3D"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:background="#080808"
            android:padding="0dp"
            android:layout_marginTop="55dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/wmsModeButton"
                android:text="GTIN → WMS QR"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="17sp"
                android:background="@drawable/glow_button"
                android:minHeight="64dp"
                android:layout_width="match_parent"
                android:layout_height="64dp"/>

            <Button
                android:id="@+id/textQrModeButton"
                android:text="GTIN → TEXT QR"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="17sp"
                android:background="@drawable/glow_button"
                android:minHeight="64dp"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="64dp"/>

        </LinearLayout>

        <TextView
            android:text="SELECT SCANNING OPTION"
            android:textColor="#FCFC3D"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:gravity="center"
            android:layout_marginTop="55dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/importCatalogButton"
            android:text="IMPORT / UPDATE CATALOG"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="15sp"
            android:background="@drawable/glow_button"
            android:minHeight="52dp"
            android:layout_marginTop="18dp"
            android:layout_width="match_parent"
            android:layout_height="52dp"/>

    </LinearLayout>

    <!-- WMS HEADER -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="12dp"
        android:background="#080808"
        android:layout_width="match_parent"
        android:layout_height="64dp">

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">

            <TextView
                android:text="GTIN → WMS QR"
                android:textColor="#FCFC3D"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="WAREHOUSE SCANNER"
                android:textColor="#FCFC3D"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/flashButton"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="Toggle flashlight"
            android:background="@android:color/transparent"
            android:tint="#FCFC3D"
            android:padding="10dp"
            android:layout_width="52dp"
            android:layout_height="52dp"/>
    </LinearLayout>

    <!-- CAMERA / SCANNER -->
    <FrameLayout
        android:id="@+id/cameraCard"
        android:background="#080808"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <com.gtinwmsqr.ScanFrameView
            android:id="@+id/scanFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <Button
            android:id="@+id/changeModeButton"
            android:text="← Change Mode"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/glow_button"
            android:minHeight="48dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:elevation="6dp"
            android:layout_width="wrap_content"
            android:layout_height="48dp"/>

        <TextView
            android:id="@+id/cameraHint"
            android:text="SCAN PRODUCT GTIN"
            android:textColor="#FCFC3D"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#080808"
            android:padding="12dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="82dp"
            android:layout_marginStart="60dp"
            android:layout_marginEnd="60dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- SCANNER CONTROL BAR -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#080808"
            android:padding="8dp"
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="66dp">

            <Button
                android:id="@+id/manualButton"
                android:text="⌨  Enter GTIN manually"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#000000"
                android:background="@drawable/glow_button"
                android:minHeight="52dp"
                android:minWidth="220dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_width="wrap_content"
                android:layout_height="52dp"/>
        </LinearLayout>
    </FrameLayout>

    <!-- MANUAL ENTRY -->
    <LinearLayout
        android:id="@+id/manualPanel"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#080808"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/gtinInput"
            android:hint="Enter / paste GTIN"
            android:textColorHint="#FCFC3D"
            android:textColor="#FCFC3D"
            android:inputType="number"
            android:singleLine="true"
            android:textSize="17sp"
            android:padding="12dp"
            android:background="#080808"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="56dp"/>

        <Button
            android:id="@+id/findButton"
            android:text="Find"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/glow_button"
            android:minHeight="52dp"
            android:layout_marginStart="10dp"
            android:layout_width="92dp"
            android:layout_height="52dp"/>
    </LinearLayout>

    <!-- RESULT CARD -->
    <ScrollView
        android:id="@+id/resultScroll"
        android:fillViewport="true"
        android:background="#080808"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#080808"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- PRODUCT CARD -->
            <LinearLayout
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/glow_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/resultTitle"
                    android:text="PRODUCT FOUND"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="#FCFC3D"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/productInfo"
                    android:textColor="#FCFC3D"
                    android:textSize="16sp"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="7dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- QR CARD -->
            <LinearLayout
                android:orientation="vertical"
                android:gravity="center"
                android:padding="18dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/glow_qr_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="QR GENERATED"
                    android:textColor="#FCFC3D"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <ImageView
                    android:id="@+id/qrImage"
                    android:adjustViewBounds="true"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:background="#FFFFFF"
                    android:padding="8dp"
                    android:layout_width="340dp"
                    android:layout_height="340dp"/>

                <LinearLayout
                    android:id="@+id/ocrQrContainer"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- ACTION BUTTONS -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/saveButton"
                    android:text="↓  Save QR"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:background="@drawable/glow_button"
                    android:minHeight="56dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="56dp"/>

                <Button
                    android:id="@+id/printButton"
                    android:text="Print"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:background="@drawable/glow_button"
                    android:minHeight="56dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="56dp"/>
            </LinearLayout>

            <!-- SCAN AGAIN -->
            <Button
                android:id="@+id/againButton"
                android:text="📷  Scan Another GTIN"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#000000"
                android:background="@drawable/glow_button"
                android:minHeight="56dp"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="56dp"/>

            <!-- SUCCESS / ERROR STATUS -->
            <TextView
                android:id="@+id/notFoundText"
                android:text="Product not found"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FCFC3D"
                android:visibility="gone"
                android:layout_marginTop="14dp"
                android:padding="16dp"
                android:background="#080808"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>
    </ScrollView>

    <!-- STATUS BAR -->
    <TextView
        android:id="@+id/statusText"
        android:text="Opening camera…"
        android:textColor="#FCFC3D"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#080808"
        android:padding="6dp"
        android:layout_width="match_parent"
        android:layout_height="32dp"/>

</LinearLayout>
