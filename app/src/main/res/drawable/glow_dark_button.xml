<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Glow -->
    <item android:left="2dp" android:right="2dp" android:top="5dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#45FFFC5C"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>

    <!-- Dark button -->
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#111111"/>
            <stroke
                android:width="1dp"
                android:color="#FFFC5C"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>

</layer-list>
