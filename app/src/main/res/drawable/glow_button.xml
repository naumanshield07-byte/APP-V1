<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Glow -->
    <item android:left="2dp" android:right="2dp" android:top="6dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#50FFFC5C"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>

    <!-- Button -->
    <item android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFC5C"/>
            <stroke
                android:width="1dp"
                android:color="#FFFFA3"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>

</layer-list>
