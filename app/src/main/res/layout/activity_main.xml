<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#2E2E2E"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MODE SELECTION -->
    <LinearLayout
        android:id="@+id/modeSelection"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#2E2E2E"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/appLogo"
            android:src="@drawable/app_logo"
            android:contentDescription="QR Generator logo"
            android:scaleType="fitCenter"
            android:layout_width="180dp"
            android:layout_height="180dp"/>

        <TextView
            android:text="TOOLS"
            android:textColor="#FCFC3D"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <GridLayout
            android:columnCount="2"
            android:layout_marginTop="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/wmsModeButton"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/glow_button_red"
                android:layout_margin="6dp"
                android:paddingTop="22dp"
                android:paddingBottom="22dp"
                android:layout_columnWeight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/ic_menu_scanner"
                    android:contentDescription="SCANNER"
                    android:layout_width="52dp"
                    android:layout_height="52dp"/>

                <TextView
                    android:text="SCANNER"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:letterSpacing="0.04"
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/textQrModeButton"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/glow_button_red"
                android:layout_margin="6dp"
                android:paddingTop="22dp"
                android:paddingBottom="22dp"
                android:layout_columnWeight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/ic_menu_text"
                    android:contentDescription="TEXT SCANNER"
                    android:layout_width="52dp"
                    android:layout_height="52dp"/>

                <TextView
                    android:text="TEXT SCANNER"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:letterSpacing="0.04"
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/slKlModeButton"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/glow_button_red"
                android:layout_margin="6dp"
                android:paddingTop="22dp"
                android:paddingBottom="22dp"
                android:layout_columnWeight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/ic_menu_slkl"
                    android:contentDescription="SL = KL"
                    android:layout_width="52dp"
                    android:layout_height="52dp"/>

                <TextView
                    android:text="SL = KL"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:letterSpacing="0.04"
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/historyButton"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/glow_button_red"
                android:layout_margin="6dp"
                android:paddingTop="22dp"
                android:paddingBottom="22dp"
                android:layout_columnWeight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/ic_menu_history"
                    android:contentDescription="HISTORY"
                    android:layout_width="52dp"
                    android:layout_height="52dp"/>

                <TextView
                    android:text="HISTORY"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:letterSpacing="0.04"
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

        </GridLayout>

        <TextView
            android:text="SELECT SCANNING OPTION"
            android:textColor="#FCFC3D"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:gravity="center"
            android:layout_marginTop="55dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/importCatalogButton"
            android:text="IMPORT / UPDATE CATALOG"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="15sp"
            android:background="@drawable/glow_button_red"
            android:minHeight="52dp"
            android:layout_marginTop="18dp"
            android:layout_width="match_parent"
            android:layout_height="52dp"/>

    </LinearLayout>

    <!-- WMS HEADER -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="12dp"
        android:background="#2E2E2E"
        android:layout_width="match_parent"
        android:layout_height="64dp">

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">

            <TextView
                android:text="TOOLS"
                android:textColor="#FCFC3D"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="MULTI-TOOL"
                android:textColor="#FCFC3D"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/flashButton"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="Toggle flashlight"
            android:background="@android:color/transparent"
            android:tint="#FCFC3D"
            android:padding="10dp"
            android:layout_width="52dp"
            android:layout_height="52dp"/>
    </LinearLayout>

    <!-- CAMERA / SCANNER -->
    <FrameLayout
        android:id="@+id/cameraCard"
        android:background="#2E2E2E"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <com.gtinwmsqr.ScanFrameView
            android:id="@+id/scanFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <Button
            android:id="@+id/changeModeButton"
            android:text="← MENU"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/glow_button_red"
            android:minHeight="48dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:elevation="6dp"
            android:layout_width="wrap_content"
            android:layout_height="48dp"/>

        <TextView
            android:id="@+id/cameraHint"
            android:text="SCAN PRODUCT GTIN"
            android:textColor="#FCFC3D"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#2E2E2E"
            android:padding="12dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="82dp"
            android:layout_marginStart="60dp"
            android:layout_marginEnd="60dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- SCANNER CONTROL BAR -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#2E2E2E"
            android:padding="8dp"
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="66dp">

            <Button
                android:id="@+id/manualButton"
                android:text="⌨  Enter GTIN manually"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#000000"
                android:background="@drawable/glow_button_red"
                android:minHeight="52dp"
                android:minWidth="220dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_width="wrap_content"
                android:layout_height="52dp"/>
        </LinearLayout>
    </FrameLayout>

    <!-- MANUAL ENTRY -->
    <LinearLayout
        android:id="@+id/manualPanel"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#2E2E2E"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/gtinInput"
            android:hint="Enter / paste GTIN"
            android:textColorHint="#FCFC3D"
            android:textColor="#FCFC3D"
            android:inputType="number"
            android:singleLine="true"
            android:textSize="17sp"
            android:padding="12dp"
            android:background="#2E2E2E"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="56dp"/>

        <Button
            android:id="@+id/findButton"
            android:text="Find"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/glow_button_red"
            android:minHeight="52dp"
            android:layout_marginStart="10dp"
            android:layout_width="92dp"
            android:layout_height="52dp"/>
    </LinearLayout>

    <!-- RESULT CARD -->
    <ScrollView
        android:id="@+id/resultScroll"
        android:fillViewport="true"
        android:background="#2E2E2E"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#2E2E2E"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- PRODUCT CARD -->
            <LinearLayout
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/glow_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/resultTitle"
                    android:text="PRODUCT FOUND"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="#FCFC3D"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/productInfo"
                    android:textColor="#FCFC3D"
                    android:textSize="16sp"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="7dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- SL / KL RESULT CARD -->
            <LinearLayout
                android:id="@+id/slKlResultCard"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/glow_qr_card"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="GTIN"
                        android:textColor="#FCFC3D"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/slKlGtinValue"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:layout_width="0dp"
                        android:layout_weight="1.7"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <View
                    android:background="#333333"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="PARTNER ID"
                        android:textColor="#FCFC3D"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/slKlPartnerValue"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:layout_width="0dp"
                        android:layout_weight="1.7"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <View
                    android:background="#333333"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="SHELF LIFE"
                        android:textColor="#FCFC3D"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/slKlShelfLifeValue"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:layout_width="0dp"
                        android:layout_weight="1.7"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <View
                    android:background="#333333"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="KEEP LIFE"
                        android:textColor="#FCFC3D"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/slKlKeepLifeValue"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:layout_width="0dp"
                        android:layout_weight="1.7"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <View
                    android:background="#333333"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="PRODUCTION DATE"
                        android:textColor="#FCFC3D"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/slKlProductionDateValue"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:layout_width="0dp"
                        android:layout_weight="1.7"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <View
                    android:background="#333333"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="SHELF LIFE DATE"
                        android:textColor="#FCFC3D"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/slKlShelfLifeDateValue"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:layout_width="0dp"
                        android:layout_weight="1.7"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <View
                    android:background="#333333"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="KEEP LIFE DATE"
                        android:textColor="#FCFC3D"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/slKlKeepLifeDateValue"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:layout_width="0dp"
                        android:layout_weight="1.7"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <View
                    android:background="#333333"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="REMAINING KEEP LIFE"
                        android:textColor="#FCFC3D"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/slKlRemainingValue"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:layout_width="0dp"
                        android:layout_weight="1.7"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <View
                    android:background="#333333"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="STATUS"
                        android:textColor="#FCFC3D"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/slKlStatusValue"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:layout_width="0dp"
                        android:layout_weight="1.7"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

            </LinearLayout>

            <!-- QR CARD -->
            <LinearLayout
                android:id="@+id/qrCard"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="18dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/glow_qr_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="QR GENERATED"
                    android:textColor="#FCFC3D"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <ImageView
                    android:id="@+id/qrImage"
                    android:adjustViewBounds="true"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:background="#FFFFFF"
                    android:padding="8dp"
                    android:layout_width="340dp"
                    android:layout_height="340dp"/>

                <LinearLayout
                    android:id="@+id/ocrQrContainer"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- ACTION BUTTONS -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/saveButton"
                    android:text="↓  Save QR"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:background="@drawable/glow_button_red"
                    android:minHeight="56dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="56dp"/>

                <Button
                    android:id="@+id/printButton"
                    android:text="Print"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:background="@drawable/glow_button_red"
                    android:minHeight="56dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="56dp"/>
            </LinearLayout>

            <!-- SCAN AGAIN -->
            <Button
                android:id="@+id/againButton"
                android:text="📷  Scan Another GTIN"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#000000"
                android:background="@drawable/glow_button_red"
                android:minHeight="56dp"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="56dp"/>

            <!-- SUCCESS / ERROR STATUS -->
            <TextView
                android:id="@+id/notFoundText"
                android:text="Product not found"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FCFC3D"
                android:visibility="gone"
                android:layout_marginTop="14dp"
                android:padding="16dp"
                android:background="#2E2E2E"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>
    </ScrollView>

    <!-- STATUS BAR -->
    <TextView
        android:id="@+id/statusText"
        android:text="Opening camera…"
        android:textColor="#FCFC3D"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#2E2E2E"
        android:padding="6dp"
        android:layout_width="match_parent"
        android:layout_height="32dp"/>

</LinearLayout>
