<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer neon glow -->
    <item android:top="-6dp" android:bottom="-6dp"
          android:left="-6dp" android:right="-6dp">
        <shape android:shape="rectangle">
            <solid android:color="#3D8B5CF6"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:top="-3dp" android:bottom="-3dp"
          android:left="-3dp" android:right="-3dp">
        <shape android:shape="rectangle">
            <solid android:color="#5CA855F7"/>
            <corners android:radius="15dp"/>
        </shape>
    </item>

    <!-- Button body gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0"
                android:startColor="#A855F7"
                android:centerColor="#7C6EF0"
                android:endColor="#3B82F6"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

    <!-- Top glass shine -->
    <item android:top="2dp" android:left="8dp" android:right="8dp"
          android:bottom="28dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="#55FFFFFF"
                android:endColor="#00FFFFFF"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
</layer-list>
